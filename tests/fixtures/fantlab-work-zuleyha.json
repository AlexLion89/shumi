prefix":"","type":"translator"}],"year":2020}]}],"val_midmark":"6.45","val_midmark_by_weight":6.54,"val_responsecount":27,"val_voters":396,"work_description":"Роман «Зулейха открывает глаза» начинается зимой 1930 года в глухой татарской деревне. Крестьянку Зулейху вместе с сотнями других переселенцев отправляют в вагоне-теплушке по извечному каторжному маршруту в Сибирь.  Дремучие крестьяне и ленинградские интеллигенты, деклассированный элемент и уголовники, мусульмане и христиане, язычники и атеисты, русские, татары, немцы, чуваши — все встретятся на берегах Ангары, ежедневно отстаивая у тайги и безжалостного государства свое право на жизнь.  Всем раскулаченным и переселенным посвящается.","work_description_author":"","work_id":667162,"work_lp":null,"work_maps":[],"work_name":"Зулейха открывает глаза","work_name_alts":[],"work_name_bonus":"","work_name_orig":"","work_notes":"","work_notfinished":0,"work_parent":null,"work_preparing":0,"work_published":1,"work_root_saga":[{}],"work_saga":null,"work_type":"Роман","work_type_icon":"novel","work_type_id":1,"work_type_name":"novel","work_year":2015,"work_year_of_write":null}